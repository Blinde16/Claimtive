# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:claimtive@localhost:5432/claimtive?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Optional: Anthropic API key to enable LLM-generated narrative insights.
# When unset, Claimtive falls back to deterministic rule-based insights.
ANTHROPIC_API_KEY=""
