# Postgres connection string used by Prisma
DATABASE_URL="postgresql://postgres:claimtive@localhost:5432/claimtive?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
AUTH_SECRET="change-me-to-a-long-random-string"

# Canonical origin of the public marketing site. Used for metadataBase, the
# canonical URL, Open Graph tags and app/sitemap.ts. Must match the host that
# public/robots.txt advertises the sitemap under.
SITE_URL="https://claimtive.com"

# --- Shared demo account (prisma/seed.ts) ---
# Leave every one of these UNSET in production. Together they are the only way
# the demo account becomes usable or visible.
#
# Server gate: whether demo@claimtive.com may sign in at all. Default-closed.
DEMO_ENABLED="false"
# Password given to the seeded demo user. If unset, `npm run db:seed` generates
# a random one and prints it once — there is deliberately no default, so no
# working password ever lives in this repository.
# DEMO_PASSWORD=""
#
# Build-time (client) flags. NEXT_PUBLIC_* values are inlined into the browser
# bundle, so setting these publishes the credentials to every visitor — only do
# it on a dedicated demo deployment. When unset, the pre-fill and the "demo
# login" copy are compiled out of the client bundle entirely.
NEXT_PUBLIC_DEMO_ENABLED="false"
# NEXT_PUBLIC_DEMO_EMAIL="demo@claimtive.com"
# Must equal DEMO_PASSWORD above, or the pre-filled form will not sign in.
# NEXT_PUBLIC_DEMO_PASSWORD=""

# --- AI layer (Gemini via Vertex AI) ---
# All three must be set for the AI insights path to activate; otherwise the
# deterministic rule-based insights run. The model is called from Cloud Run
# (App Hosting) directly to Vertex within the same GCP project, under the
# Google Cloud BAA — no external vendor. Gemini (first-party) has generous
# default quota; Anthropic-on-Vertex defaults to ~0 pending a quota grant.
AI_ENABLED="false"
VERTEX_PROJECT_ID="claimtive"
VERTEX_REGION="us-central1"
# A Vertex Gemini model id, e.g. gemini-2.5-flash (cheap, ample for summaries).
VERTEX_MODEL="gemini-2.5-flash"
